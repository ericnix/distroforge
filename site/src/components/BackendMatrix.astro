---
import catalog from '../data/catalog.json';

const rows = catalog.bases.map((base) => ({
  ...base,
  netinstall:
    base.installer === 'Calamares'
      ? 'packagechooser + netinstall'
      : base.installer === 'Anaconda'
        ? 'kickstart %packages'
        : 'perfil JSON (Agama)',
}));
---

<section id="backends" class="page scroll-mt-24 py-20">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div class="max-w-2xl">
      <p class="eyebrow">Backends</p>
      <h2 class="h2 mt-2">Cada base no seu habitat.</h2>
      <p class="muted mt-2 text-sm leading-relaxed">
        O build roda dentro de um container da própria base. Debian e Ubuntu compartilham o
        <code class="kbd">live-build</code>; Arch usa <code class="kbd">archiso</code>.
      </p>
    </div>
    <span class="chip">3 de 5 no MVP</span>
  </div>

  <div class="mt-8 overflow-x-auto rounded-xl border border-ink-700">
    <table class="w-full min-w-[42rem] border-collapse text-left text-sm">
      <thead>
        <tr class="border-b border-ink-700 bg-ink-850 text-[11px] uppercase tracking-wider text-fog-500">
          <th scope="col" class="px-4 py-3 font-semibold">Base</th>
          <th scope="col" class="px-4 py-3 font-semibold">Builder</th>
          <th scope="col" class="px-4 py-3 font-semibold">Instalador</th>
          <th scope="col" class="px-4 py-3 font-semibold">Netinstall</th>
          <th scope="col" class="px-4 py-3 font-semibold">Status</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr class="border-b border-ink-800 last:border-0 hover:bg-ink-900/50">
            <td class="px-4 py-3">
              <span class="flex items-center gap-2">
                <span class="size-2 rounded-full" style={`background:${row.accent}`}></span>
                <span class="font-medium text-white">{row.label}</span>
                <span class="text-xs text-fog-500">{row.release}</span>
              </span>
            </td>
            <td class="px-4 py-3 font-mono text-xs text-fog-300">{row.builder}</td>
            <td class="px-4 py-3 font-mono text-xs text-fog-300">{row.installer}</td>
            <td class="px-4 py-3 text-xs text-fog-400">{row.netinstall}</td>
            <td class="px-4 py-3">
              {row.status === 'stable' ? (
                <span class="chip !border-mint-400/30 !text-mint-400">MVP</span>
              ) : (
                <span class="chip">planejado</span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="mt-3 text-xs text-fog-500">
    Fedora e openSUSE não usam Calamares: entram com Anaconda (kickstart parcial) e Agama (perfil
    JSON), em fases posteriores.
  </p>
</section>
