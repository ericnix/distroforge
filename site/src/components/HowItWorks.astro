---
import { SITE } from '../config';

const steps = [
  {
    n: '01',
    title: 'Escolha',
    text: 'Base, desktop ou WM, programas e branding. O catálogo sabe o nome de cada pacote em cada distro.',
  },
  {
    n: '02',
    title: 'Gere o perfil',
    text: 'Um profile.yaml neutro. É o único contrato entre a interface e os backends de build.',
  },
  {
    n: '03',
    title: 'Builda a ISO',
    text: 'O build roda em um container podman da base escolhida. Nada suja o seu sistema.',
  },
];

const builders = [
  { base: 'Debian / Ubuntu', tool: 'live-build' },
  { base: 'Arch Linux', tool: 'archiso' },
  { base: 'Fedora', tool: 'lorax' },
  { base: 'openSUSE', tool: 'kiwi' },
];

const installers = [
  { base: 'Debian / Ubuntu / Arch', tool: 'Calamares' },
  { base: 'Fedora', tool: 'Anaconda + kickstart' },
  { base: 'openSUSE', tool: 'Agama (perfil JSON)' },
];
---

<section id="como-funciona" class="page scroll-mt-24 py-20">
  <div class="max-w-2xl">
    <p class="eyebrow">Arquitetura</p>
    <h2 class="h2 mt-2">Duas dimensões independentes.</h2>
    <p class="muted mt-2 text-sm leading-relaxed">
      Montar a ISO e apresentar as opções de instalação são problemas separados. Misturá-los é o que
      torna projetos assim ingovernáveis — aqui, adicionar uma base é só um builder e um adapter.
    </p>
  </div>

  <div class="mt-8 grid gap-3 md:grid-cols-3">
    {steps.map((step) => (
      <div class="card p-5">
        <span class="font-mono text-xs text-brand-400">{step.n}</span>
        <h3 class="mt-2 font-semibold text-white">{step.title}</h3>
        <p class="mt-1.5 text-xs leading-relaxed text-fog-400">{step.text}</p>
      </div>
    ))}
  </div>

  <!-- Diagrama -->
  <div class="card mt-3 overflow-hidden p-5 sm:p-7">
    <div class="mx-auto max-w-md rounded-lg border border-brand-500/40 bg-brand-500/10 px-4 py-3 text-center">
      <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-brand-300">Perfil neutro</p>
      <p class="mt-0.5 font-mono text-sm text-white">profile.yaml</p>
    </div>

    <div class="mx-auto my-2 h-5 w-px bg-ink-600" aria-hidden="true"></div>

    <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-lg border border-ink-700 bg-ink-850 p-4">
        <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-fog-500">Base builder</p>
        <p class="mt-0.5 text-xs text-fog-400">monta o live ISO</p>
        <ul class="mt-3 space-y-1.5">
          {builders.map((item) => (
            <li class="flex items-center justify-between gap-2 text-xs">
              <span class="text-fog-400">{item.base}</span>
              <span class="font-mono text-fog-200">{item.tool}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-lg border border-ink-700 bg-ink-850 p-4">
        <p class="text-[10px] font-semibold uppercase tracking-[0.16em] text-fog-500">Installer adapter</p>
        <p class="mt-0.5 text-xs text-fog-400">traduz o perfil na instalação</p>
        <ul class="mt-3 space-y-1.5">
          {installers.map((item) => (
            <li class="flex items-center justify-between gap-2 text-xs">
              <span class="text-fog-400">{item.base}</span>
              <span class="font-mono text-fog-200">{item.tool}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <div class="mx-auto my-2 h-5 w-px bg-ink-600" aria-hidden="true"></div>

    <div class="mx-auto max-w-md rounded-lg border border-mint-400/30 bg-mint-400/5 px-4 py-3 text-center">
      <p class="font-mono text-xs text-mint-400">
        minhadistro-1.0-amd64.iso <span class="text-fog-500">· ~800 MB</span>
      </p>
    </div>
  </div>

  <!-- CLI -->
  <div class="card mt-3 overflow-hidden">
    <div class="border-b border-ink-700 bg-ink-850 px-4 py-2.5">
      <p class="font-mono text-[11px] text-fog-500">construir sem a interface</p>
    </div>
    <pre class="thin-scroll overflow-x-auto p-4 font-mono text-[12px] leading-relaxed text-fog-300"><code><span class="text-mint-400">$</span> git clone {SITE.repo}
<span class="text-mint-400">$</span> cd distroforge
<span class="text-mint-400">$</span> python3 scripts/export_catalog.py
<span class="text-mint-400">$</span> distroforge build profile.yaml --out ./out
<span class="text-fog-500">→ container podman: debian:trixie-slim</span>
<span class="text-fog-500">→ lb config + lb build</span>
<span class="text-mint-400">✓ ./out/minhadistro-1.0-amd64.iso</span></code></pre>
  </div>
</section>
