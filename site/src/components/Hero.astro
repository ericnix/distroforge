---
import { SITE } from '../config';

const highlights = [
  'Netinstall: baixa só o desktop e os apps que você escolher',
  'Calamares configurado, com catálogo e branding próprios',
  'O sistema instalado atualiza pelos repositórios da base',
];
---

<section id="topo" class="page pt-14 pb-8 sm:pt-20">
  <div class="grid gap-12 lg:grid-cols-[1.05fr_1fr] lg:items-center">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <span class="chip !border-mint-400/30 !text-mint-400">
          <span class="size-1.5 rounded-full bg-mint-400"></span>
          {SITE.license}
        </span>
        <span class="chip">MVP: Debian · Ubuntu · Arch</span>
      </div>

      <h1 class="mt-5 text-[2.6rem] leading-[1.05] font-extrabold tracking-tight text-white sm:text-5xl lg:text-[3.5rem]">
        Monte sua<br />
        <span class="bg-gradient-to-r from-brand-300 via-brand-400 to-mint-400 bg-clip-text text-transparent">
          distro Linux
        </span>
        <br />
        em minutos.
      </h1>

      <p class="mt-5 max-w-lg text-[15px] leading-relaxed text-fog-400">
        Um construtor com interface gráfica: escolha a base, o desktop e os programas, e gere uma ISO
        netinstall com instalador. O usuário final ainda troca o que quiser na hora de instalar.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-3">
        <a href="#montar" class="btn-primary">
          Montar agora
          <svg viewBox="0 0 16 16" class="size-4" fill="none" stroke="currentColor" stroke-width="2"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M3 8h9M8 4l4 4-4 4" />
          </svg>
        </a>
        <a href="#instalador" class="btn-ghost">Ver o instalador</a>
      </div>

      <ul class="mt-8 space-y-2.5">
        {highlights.map((item) => (
          <li class="flex items-start gap-2.5 text-sm text-fog-300">
            <svg viewBox="0 0 16 16" class="mt-0.5 size-4 shrink-0 text-mint-400" fill="none"
              stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"
              aria-hidden="true">
              <path d="M3 8.5l3 3 7-7" />
            </svg>
            {item}
          </li>
        ))}
      </ul>
    </div>

    <!-- Terminal ilustrativo -->
    <div class="relative">
      <div class="absolute -inset-3 -z-10 rounded-3xl bg-brand-500/10 blur-2xl" aria-hidden="true"></div>
      <div class="overflow-hidden rounded-xl border border-ink-600 bg-ink-950 shadow-2xl shadow-black/60">
        <div class="flex items-center gap-2 border-b border-ink-700 bg-ink-900 px-4 py-2.5">
          <span class="size-2.5 rounded-full bg-rose-400/70" aria-hidden="true"></span>
          <span class="size-2.5 rounded-full bg-amber-400/70" aria-hidden="true"></span>
          <span class="size-2.5 rounded-full bg-mint-400/70" aria-hidden="true"></span>
          <span class="ml-2 font-mono text-[11px] text-fog-500">~/distroforge</span>
        </div>
        <div class="thin-scroll overflow-x-auto p-4 font-mono text-[12px] leading-[1.9]">
          <p><span class="text-mint-400">$</span> <span class="text-fog-200">distroforge init</span> <span class="text-brand-300">minhadistro</span></p>
          <p class="text-fog-500">✓ perfil criado · base debian 13 (trixie)</p>
          <p class="mt-2"><span class="text-mint-400">$</span> <span class="text-fog-200">distroforge build</span> <span class="text-brand-300">profile.yaml</span></p>
          <p class="text-fog-400"><span class="text-fog-600">→</span> builder    <span class="text-fog-200">live-build</span></p>
          <p class="text-fog-400"><span class="text-fog-600">→</span> installer  <span class="text-fog-200">calamares</span></p>
          <p class="text-fog-400"><span class="text-fog-600">→</span> desktop    <span class="text-fog-200">kde</span> <span class="text-fog-600">+ 7 apps</span></p>
          <p class="text-fog-400"><span class="text-fog-600">→</span> container  <span class="text-fog-200">podman (privileged)</span></p>
          <p class="mt-2 text-fog-500">→ gerando squashfs…</p>
          <p class="text-mint-400">✓ out/minhadistro-1.0-amd64.iso <span class="text-fog-300">810 MB</span></p>
          <p class="text-fog-600">  sha256 4f9c…2a · 11m42s</p>
        </div>
      </div>

      <div class="absolute -right-2 -bottom-4 hidden rounded-lg border border-ink-600 bg-ink-900 px-3 py-2 shadow-lg sm:block">
        <p class="text-[9px] font-semibold uppercase tracking-wider text-fog-500">ISO final</p>
        <p class="font-mono text-sm font-semibold text-white">≈ 800 MB</p>
      </div>
    </div>
  </div>

  <dl class="mt-14 grid grid-cols-2 gap-3 border-t border-ink-800 pt-8 sm:grid-cols-4">
    {[
      ['3', 'bases no MVP'],
      ['28', 'apps no catálogo'],
      ['~800 MB', 'por ISO'],
      ['GPL-3', 'licença'],
    ].map(([value, label]) => (
      <div>
        <dt class="text-[10px] font-semibold uppercase tracking-[0.16em] text-fog-500">{label}</dt>
        <dd class="mt-1 text-xl font-bold text-white">{value}</dd>
      </div>
    ))}
  </dl>
</section>
