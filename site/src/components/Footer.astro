---
import { SITE } from '../config';

const year = new Date().getFullYear();

const nav = [
  { href: '#montar', label: 'Montar distro' },
  { href: '#instalador', label: 'Prévia do instalador' },
  { href: '#como-funciona', label: 'Como funciona' },
  { href: '#catalogo', label: 'Catálogo' },
  { href: '#roadmap', label: 'Roadmap' },
  { href: '#faq', label: 'FAQ' },
];
---

<footer class="mt-24 border-t border-ink-800/80 bg-ink-900/40">
  <div class="page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-4">
    <div class="lg:col-span-2">
      <div class="flex items-center gap-2.5">
        <span class="grid size-7 place-items-center rounded-md bg-gradient-to-br from-brand-400 to-brand-600">
          <svg viewBox="0 0 24 24" class="size-3.5" fill="none" stroke="#06070b" stroke-width="2.6"
            stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M8 7l-4 5 4 5" />
            <path d="M13 17h7" />
          </svg>
        </span>
        <span class="font-bold text-white">{SITE.name}</span>
      </div>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-fog-400">
        Construtor de distros Linux: escolha a base, o desktop e os programas, e gere uma ISO
        netinstall com instalador. O sistema instalado atualiza dos repositórios da própria base.
      </p>
      <p class="mt-4 text-xs text-fog-500">
        Não afiliado a Debian, Ubuntu, Arch, Fedora ou openSUSE. Nomes e marcas pertencem aos seus
        respectivos donos.
      </p>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-fog-500">Navegar</h3>
      <ul class="mt-4 space-y-2.5">
        {nav.map((item) => (
          <li>
            <a href={item.href} class="text-sm text-fog-300 transition-colors hover:text-white">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </div>

    <div>
      <h3 class="text-xs font-semibold uppercase tracking-[0.16em] text-fog-500">Projeto</h3>
      <ul class="mt-4 space-y-2.5">
        <li>
          <a href={SITE.repo} target="_blank" rel="noopener noreferrer"
            class="text-sm text-fog-300 transition-colors hover:text-white">Repositório</a>
        </li>
        <li>
          <a href={SITE.docs} target="_blank" rel="noopener noreferrer"
            class="text-sm text-fog-300 transition-colors hover:text-white">Documentação</a>
        </li>
        <li>
          <a href={`${SITE.repo}/issues`} target="_blank" rel="noopener noreferrer"
            class="text-sm text-fog-300 transition-colors hover:text-white">Issues</a>
        </li>
        <li>
          <a href={`${SITE.repo}/blob/main/LICENSE`} target="_blank" rel="noopener noreferrer"
            class="text-sm text-fog-300 transition-colors hover:text-white">Licença GPL-3.0</a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-ink-800/80">
    <div class="page flex flex-col gap-2 py-6 text-xs text-fog-500 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {SITE.name} — software livre sob {SITE.license}.</p>
      <p class="font-mono">
        <span class="text-mint-400">$</span> buildada com Astro + Svelte + Tailwind
      </p>
    </div>
  </div>
</footer>
